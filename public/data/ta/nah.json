{
  "bookId": "nah",
  "bookName": "நாகூம்",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "நினிவேயைக் குறித்த இறைவாக்கு; எல்கோசைச் சார்ந்த நாகூம் கண்ட காட்சி நூல்."
        },
        {
          "verse": 2,
          "text": "ஆண்டவர்"
        },
        {
          "verse": 3,
          "text": "ஆண்டவர் விரைவில்"
        },
        {
          "verse": 4,
          "text": "அவர் கடலை அதட்டி"
        },
        {
          "verse": 5,
          "text": "அவர் முன்னிலையில்"
        },
        {
          "verse": 6,
          "text": "அவரது கடும் சினத்தை"
        },
        {
          "verse": 7,
          "text": "ஆண்டவர் நல்லவர்;"
        },
        {
          "verse": 8,
          "text": "தம் எதிரிகளைப்"
        },
        {
          "verse": 9,
          "text": "ஆண்டவரைப்பற்றி"
        },
        {
          "verse": 10,
          "text": "குடிவெறியில்"
        },
        {
          "verse": 11,
          "text": "ஆண்டவருக்கு எதிராய்த்"
        },
        {
          "verse": 12,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 13,
          "text": "இப்பொழுதே,"
        },
        {
          "verse": 14,
          "text": "ஆண்டவர் உன்னைப்பற்றி"
        },
        {
          "verse": 15,
          "text": "\"வெற்றி! வெற்றி!\" என்று முழங்கி"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "உன்னைச் சிதறடிப்பவன் உனக்கு"
        },
        {
          "verse": 2,
          "text": "இஸ்ரயேலின் மேன்மை போலவே"
        },
        {
          "verse": 3,
          "text": "எதிரியுடைய வீரர்களின் கேடயங்கள்"
        },
        {
          "verse": 4,
          "text": "வெறிபிடித்தவனைப்போல்"
        },
        {
          "verse": 5,
          "text": "படைத்தலைவர்கள்"
        },
        {
          "verse": 6,
          "text": "ஆறுகளின் மதகுகள்"
        },
        {
          "verse": 7,
          "text": "அரசி அணிகள் களையப்பெற்று"
        },
        {
          "verse": 8,
          "text": "உடைத்துக்கொண்ட"
        },
        {
          "verse": 9,
          "text": "வெள்ளியைக் கொள்ளையடியுங்கள்;"
        },
        {
          "verse": 10,
          "text": "வெறுமை! பாழ்! அழிவு!"
        },
        {
          "verse": 11,
          "text": "சிங்கங்களின் குகை எங்கே?"
        },
        {
          "verse": 12,
          "text": "சிங்கம் தன் குட்டிகளுக்கும்"
        },
        {
          "verse": 13,
          "text": "இதோ! படைகளின்"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "இரத்தக்கறை படிந்த நகருக்கு ஐயோ"
        },
        {
          "verse": 2,
          "text": "சாட்டையடிகளின் ஓசை!"
        },
        {
          "verse": 3,
          "text": "குதிரை வீரர்கள் பாய்ந்து"
        },
        {
          "verse": 4,
          "text": "அழகும் கவர்ச்சியும் நிறைந்தவளாய்,"
        },
        {
          "verse": 5,
          "text": "இதோ! படைகளின்"
        },
        {
          "verse": 6,
          "text": "அருவருப்பானவற்றை"
        },
        {
          "verse": 7,
          "text": "உன்னை நோக்குவோர் எல்லாரும்"
        },
        {
          "verse": 8,
          "text": "நைல் நதியின் கரையருகில்"
        },
        {
          "verse": 9,
          "text": "எத்தியோப்பியாவும் எகிப்தும்"
        },
        {
          "verse": 10,
          "text": "இருந்தும், அதன் மக்கள்"
        },
        {
          "verse": 11,
          "text": "நீயும் குடிவெறியில்"
        },
        {
          "verse": 12,
          "text": "உன் அரண்கள் யாவும்"
        },
        {
          "verse": 13,
          "text": "உன் போர்வீரர்கள்"
        },
        {
          "verse": 14,
          "text": "முற்றுகை நாள்களுக்காகத்"
        },
        {
          "verse": 15,
          "text": "ஆயினும், நெருப்பு"
        },
        {
          "verse": 16,
          "text": "விண்மீன்களைவிட மிகுதியாக"
        },
        {
          "verse": 17,
          "text": "உன் காவல் வீரர்கள்"
        },
        {
          "verse": 18,
          "text": "அசீரிய மன்னனே!"
        },
        {
          "verse": 19,
          "text": "உன் காயத்துக்கு மருந்தில்லை,"
        }
      ]
    }
  ]
}