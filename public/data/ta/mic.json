{
  "bookId": "mic",
  "bookName": "மீக்கா",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "யூதாவின் அரசர்களான யோத்தாம், ஆகாசு, எசேக்கியா ஆகியவர்களின் காலத்தில் மோரசேத்தைச் சார்ந்த மீக்காவுக்கு அருளப்பட்ட ஆண்டவரின் வாக்கு: அவர் சமாரியாவையும் எருசலேமையும் குறித்துக் கண்ட காட்சி இதுவே:"
        },
        {
          "verse": 2,
          "text": "மக்களினங்களே,"
        },
        {
          "verse": 3,
          "text": "இதோ! ஆண்டவர்"
        },
        {
          "verse": 4,
          "text": "நெருப்பின்முன் வைக்கப்பட்ட"
        },
        {
          "verse": 5,
          "text": "யாக்கோபின் குற்றத்தை முன்னிட்டும்"
        },
        {
          "verse": 6,
          "text": "ஆதலால், சமாரியாவைப்"
        },
        {
          "verse": 7,
          "text": "அதன் செதுக்குப் படிமங்கள் எல்லாம்"
        },
        {
          "verse": 8,
          "text": "இதை முன்னிட்டே"
        },
        {
          "verse": 9,
          "text": "ஏனெனில், சமாரியாவின்"
        },
        {
          "verse": 10,
          "text": "காத்தில் இதை அறிவிக்கவேண்டாம்;"
        },
        {
          "verse": 11,
          "text": "சாபீரில் குடியிருப்போரே,"
        },
        {
          "verse": 12,
          "text": "மாரோத்தில் குடியிருப்போர்"
        },
        {
          "verse": 13,
          "text": "இலாக்கீசில் குடியிருப்போரே,"
        },
        {
          "verse": 14,
          "text": "ஆதலால், மோரசேத்துகாத்துக்கு"
        },
        {
          "verse": 15,
          "text": "மாரேசாவில் குடியிருப்போரே,"
        },
        {
          "verse": 16,
          "text": "உங்கள் அருமைப்"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "தங்கள் படுக்கைகளின்மேல் சாய்ந்து"
        },
        {
          "verse": 2,
          "text": "வயல் வெளிகள்மீது ஆசை கொண்டு,"
        },
        {
          "verse": 3,
          "text": "ஆதலால், ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 4,
          "text": "அந்நாளில் மக்கள் உங்களைப் பற்றி"
        },
        {
          "verse": 5,
          "text": "ஆதலால், நூல்பிடித்துப்"
        },
        {
          "verse": 6,
          "text": "அவர்கள் பிதற்றுவது:"
        },
        {
          "verse": 7,
          "text": "யாக்கோபின் குடும்பத்தாரே,"
        },
        {
          "verse": 8,
          "text": "ஆனால், நீங்கள்தாம் என் மக்களைப்"
        },
        {
          "verse": 9,
          "text": "என் மக்களின் கூட்டத்திலுள்ள"
        },
        {
          "verse": 10,
          "text": "எழுந்து அகன்றுபோங்கள்;"
        },
        {
          "verse": 11,
          "text": "‘திராட்சை இரசத்தையும்"
        },
        {
          "verse": 12,
          "text": "யாக்கோபே!"
        },
        {
          "verse": 13,
          "text": "அவர்களின் வழிகாட்டிகள்"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "அப்பொழுது நான் கூறியது:"
        },
        {
          "verse": 2,
          "text": "நீங்களோ நன்மையை வெறுத்துத்"
        },
        {
          "verse": 3,
          "text": "என் மக்களின் சதையைத்"
        },
        {
          "verse": 4,
          "text": "அப்பொழுது நீங்கள்"
        },
        {
          "verse": 5,
          "text": "இறைவாக்கினர்களைக் குறித்து"
        },
        {
          "verse": 6,
          "text": "ஆதலால் \"இறைவாக்கினரே,"
        },
        {
          "verse": 7,
          "text": "காட்சி காண்பவர்கள்"
        },
        {
          "verse": 8,
          "text": "ஆனால், நான் யாக்கோபுக்கு"
        },
        {
          "verse": 9,
          "text": "யாக்கோபு குடும்பத்தாரின்"
        },
        {
          "verse": 10,
          "text": "இரத்தப்பழியால் சீயோனையும்,"
        },
        {
          "verse": 11,
          "text": "அந்த நகரின் தலைவர்கள்"
        },
        {
          "verse": 12,
          "text": "ஆதலால், உங்களை முன்னிட்டுச்"
        }
      ]
    },
    {
      "chapter": 4,
      "verses": [
        {
          "verse": 1,
          "text": "\"இறுதி நாள்களில் ஆண்டவரின்"
        },
        {
          "verse": 2,
          "text": "வேற்றினத்தார் பலர்"
        },
        {
          "verse": 3,
          "text": "அவரே பல மக்களினங்களுக்கு"
        },
        {
          "verse": 4,
          "text": "அவர்களுள் ஒவ்வொருவரும்"
        },
        {
          "verse": 5,
          "text": "மக்களினங்கள் யாவும்"
        },
        {
          "verse": 6,
          "text": "அந்நாளில், \"நான்"
        },
        {
          "verse": 7,
          "text": "முடமாக்கப்பட்டோரை"
        },
        {
          "verse": 8,
          "text": "மந்தையின் காவல் மாடமே!"
        },
        {
          "verse": 9,
          "text": "இப்போது நீ கூக்குரலிட்டுக்"
        },
        {
          "verse": 10,
          "text": "மகளே சீயோன்!"
        },
        {
          "verse": 11,
          "text": "இப்பொழுது, வேற்றினத்தார் பலர்"
        },
        {
          "verse": 12,
          "text": "ஆனால் அவர்கள் ஆண்டவரின்"
        },
        {
          "verse": 13,
          "text": "மகள் சீயோனே, நீ எழுந்து புணையடி;"
        }
      ]
    },
    {
      "chapter": 5,
      "verses": [
        {
          "verse": 1,
          "text": "அரண்சூழ் நகரில் வாழும் மக்களே!"
        },
        {
          "verse": 2,
          "text": "நீயோ, எப்ராத்தா எனப்படும்"
        },
        {
          "verse": 3,
          "text": "ஆதலால்,"
        },
        {
          "verse": 4,
          "text": "அவர் வரும்போது,"
        },
        {
          "verse": 5,
          "text": "அவரே அமைதியை அருள்வார்."
        },
        {
          "verse": 5,
          "text": "அசீரியர் நம் நாட்டிற்குள்"
        },
        {
          "verse": 6,
          "text": "அவர்கள் அசீரியா நாடு முழுவதையும்"
        },
        {
          "verse": 7,
          "text": "அப்போது யாக்கோபில் எஞ்சியிருப்போர்"
        },
        {
          "verse": 8,
          "text": "மேலும், யாக்கோபிலே எஞ்சியிருப்போர்"
        },
        {
          "verse": 9,
          "text": "உனது கை"
        },
        {
          "verse": 10,
          "text": "அந்நாளில், \"நான் உன்னிடமுள்ள"
        },
        {
          "verse": 11,
          "text": "\"உன் நாட்டிலுள்ள நகர்களைத்"
        },
        {
          "verse": 12,
          "text": "உன்னுடைய மாயவித்தைக்காரர்களை"
        },
        {
          "verse": 13,
          "text": "நீ செய்து வைத்திருக்கும்"
        },
        {
          "verse": 14,
          "text": "நீ நிறுத்தியிருக்கும் கம்பங்களைப்"
        },
        {
          "verse": 15,
          "text": "எனக்குச் செவி கொடாத"
        }
      ]
    },
    {
      "chapter": 6,
      "verses": [
        {
          "verse": 1,
          "text": "ஆண்டவர் கூறுவதைக் கேளுங்கள்:"
        },
        {
          "verse": 2,
          "text": "மலைகளே, மண்ணுலகின்"
        },
        {
          "verse": 3,
          "text": "என் மக்களே,"
        },
        {
          "verse": 4,
          "text": "நான் உங்களை எகிப்து நாட்டிலிருந்து"
        },
        {
          "verse": 5,
          "text": "என் மக்களே, மோவாபு அரசன்"
        },
        {
          "verse": 6,
          "text": "ஆண்டவரின் திருமுன் வரும்போது"
        },
        {
          "verse": 7,
          "text": "ஆயிரக்கணக்கான"
        },
        {
          "verse": 8,
          "text": "ஓ மானிடா, நல்லது எது என"
        },
        {
          "verse": 9,
          "text": "ஆண்டவரின் குரல்"
        },
        {
          "verse": 10,
          "text": "\"கொடியோரின் வீட்டில்"
        },
        {
          "verse": 11,
          "text": "கள்ளத் தராசையும்"
        },
        {
          "verse": 12,
          "text": "உங்களிடையே உள்ள செல்வர்கள்"
        },
        {
          "verse": 13,
          "text": "ஆதலால், நான் உங்களை"
        },
        {
          "verse": 14,
          "text": "நீங்கள் உணவருந்தினாலும்"
        },
        {
          "verse": 15,
          "text": "நீங்கள் விதைப்பீர்கள்;"
        },
        {
          "verse": 16,
          "text": "ஏனெனில், நீங்கள்"
        }
      ]
    },
    {
      "chapter": 7,
      "verses": [
        {
          "verse": 1,
          "text": "ஐயோ! நான் கோடைக்காலக் கனிகளைக்"
        },
        {
          "verse": 2,
          "text": "நாட்டில் இறைப்பற்றுள்ளோர்"
        },
        {
          "verse": 3,
          "text": "தீமை செய்வதில்"
        },
        {
          "verse": 4,
          "text": "அவர்களுள் சிறந்தவர்"
        },
        {
          "verse": 5,
          "text": "அடுத்திருப்பவன்மீது"
        },
        {
          "verse": 6,
          "text": "ஏனெனில், மகன் தன் தந்தையை"
        },
        {
          "verse": 7,
          "text": "நானோ, ஆண்டவரை"
        },
        {
          "verse": 8,
          "text": "என் பகைவனே,"
        },
        {
          "verse": 9,
          "text": "நான் ஆண்டவருக்கு எதிராகப்"
        },
        {
          "verse": 10,
          "text": "அப்போது, என்னோடு"
        },
        {
          "verse": 11,
          "text": "உன் மதில்களைத்"
        },
        {
          "verse": 12,
          "text": "அந்நாளில், அசீரியாவிலிருந்து"
        },
        {
          "verse": 13,
          "text": "நிலவுலகம்"
        },
        {
          "verse": 14,
          "text": "ஆண்டவரே,"
        },
        {
          "verse": 15,
          "text": "எகிப்து நாட்டிலிருந்து"
        },
        {
          "verse": 16,
          "text": "வேற்றினத்தார் இதைப் பார்த்துத்"
        },
        {
          "verse": 17,
          "text": "அவர்கள் பாம்பைப் போலவும்"
        },
        {
          "verse": 18,
          "text": "உமக்கு நிகரான இறைவன் யார்?"
        },
        {
          "verse": 19,
          "text": "அவர் நம்மீது இரக்கம் காட்டுவார்;"
        },
        {
          "verse": 20,
          "text": "பண்டைய நாளில்"
        }
      ]
    }
  ]
}