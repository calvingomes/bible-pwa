{
  "bookId": "lam",
  "bookName": "புலம்பல்",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "அந்தோ! மக்கள் மிகுந்த மாநகர்"
        },
        {
          "verse": 2,
          "text": "ஆறாத் துயருற்று"
        },
        {
          "verse": 3,
          "text": "இன்னலுற்ற அடிமையான யூதா"
        },
        {
          "verse": 4,
          "text": "விழாக்களுக்குச் செல்பவர்"
        },
        {
          "verse": 5,
          "text": "உயர் தலைவர் ஆயினர்"
        },
        {
          "verse": 6,
          "text": "அனைத்து மேன்மையும்"
        },
        {
          "verse": 7,
          "text": "எருசலேம், தன் துன்ப நாள்களிலும்,"
        },
        {
          "verse": 8,
          "text": "ஏராளமாய்ப் பாவம் செய்தாள்"
        },
        {
          "verse": 9,
          "text": "ஐயகோ! அவள் தீட்டு"
        },
        {
          "verse": 10,
          "text": "ஒப்பற்ற அவளது விருப்பமான"
        },
        {
          "verse": 11,
          "text": "உணவைத் தேடி"
        },
        {
          "verse": 12,
          "text": "இவ்வழியாய்க் கடந்து செல்வோரே!"
        },
        {
          "verse": 13,
          "text": "மேலிருந்து அவர் நெருப்பினை"
        },
        {
          "verse": 14,
          "text": "என் குற்றங்கள் என்னும் நுகம்"
        },
        {
          "verse": 15,
          "text": "என் தலைவர் என்னிடமுள்ள"
        },
        {
          "verse": 16,
          "text": "இவற்றின் பொருட்டு"
        },
        {
          "verse": 17,
          "text": "சீயோன் தன் கைகளை"
        },
        {
          "verse": 18,
          "text": "ஆண்டவரோ நீதியுள்ளவர்;"
        },
        {
          "verse": 19,
          "text": "என் காதலர்களை அழைத்தேன்;"
        },
        {
          "verse": 20,
          "text": "ஆண்டவரே,"
        },
        {
          "verse": 21,
          "text": "நான் விடும் பெருமூச்சை"
        },
        {
          "verse": 22,
          "text": "அவர்கள் தீச்செயல்கள் அனைத்தும்"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "ஐயோ! மகள் சீயோனை ஆண்டவர்"
        },
        {
          "verse": 2,
          "text": "ஆண்டவர் யாக்கோபின்"
        },
        {
          "verse": 3,
          "text": "அவர் வெஞ்சினம் கொண்டு"
        },
        {
          "verse": 4,
          "text": "எதிரி போலத்"
        },
        {
          "verse": 5,
          "text": "என் தலைவர் எதிரி போலானார்;"
        },
        {
          "verse": 6,
          "text": "தோட்டத்துப் பரணைப்"
        },
        {
          "verse": 7,
          "text": "என் தலைவர் தம் பலிபீடத்தை"
        },
        {
          "verse": 8,
          "text": "மகள் சீயோனின் மதிலை அழிக்க"
        },
        {
          "verse": 9,
          "text": "அவளின் வாயிற்கதவுகள்"
        },
        {
          "verse": 10,
          "text": "மகள் சீயோனின் பெரியோர்"
        },
        {
          "verse": 11,
          "text": "என் கண்கள் கண்ணீர் சொரிந்து"
        },
        {
          "verse": 12,
          "text": "அவர்கள் தங்கள் அன்னையரிடம்,"
        },
        {
          "verse": 13,
          "text": "மகளே! எருசலேம்!"
        },
        {
          "verse": 14,
          "text": "உன் இறைவாக்கினர் உனக்காகப்"
        },
        {
          "verse": 15,
          "text": "அவ்வழியாய்க் கடந்து செல்வோர்"
        },
        {
          "verse": 16,
          "text": "உன் எதிரிகள் அனைவரும்"
        },
        {
          "verse": 17,
          "text": "ஆண்டவர்"
        },
        {
          "verse": 18,
          "text": "அவர்களின் இதயம்"
        },
        {
          "verse": 19,
          "text": "எழு! இரவில் முதற் சாமத்தில்"
        },
        {
          "verse": 20,
          "text": "கண்ணோக்கும் ஆண்டவரே!"
        },
        {
          "verse": 21,
          "text": "வீதிகளின் புழுதியில்"
        },
        {
          "verse": 22,
          "text": "திருவிழாவுக்கு அழைப்பது போல,"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "ஆண்டவரது சினத்தின் கோலால்"
        },
        {
          "verse": 2,
          "text": "அவர் என்னைத் துரத்தியடித்து,"
        },
        {
          "verse": 3,
          "text": "உண்மையில் அவர் என்மீது"
        },
        {
          "verse": 4,
          "text": "அவர் என் சதையையும் தோலையும்"
        },
        {
          "verse": 5,
          "text": "அவர் கசப்பாலும் துயராலும்"
        },
        {
          "verse": 6,
          "text": "பண்டைக் காலத்தில் இறந்தோர் போல,"
        },
        {
          "verse": 7,
          "text": "நான் தப்பிச் செல்ல இயலாதவாறு"
        },
        {
          "verse": 8,
          "text": "துணை வேண்டி"
        },
        {
          "verse": 9,
          "text": "செதுக்கிய கற்களால் என் வழிகளில்"
        },
        {
          "verse": 10,
          "text": "பதுங்கியிருக்கும் கரடி போன்றும்"
        },
        {
          "verse": 11,
          "text": "என் வழிகளினின்று"
        },
        {
          "verse": 12,
          "text": "அவர் தமது வில்லை நாணேற்றினார்!"
        },
        {
          "verse": 13,
          "text": "அவர் தமது அம்புக் கூட்டின் அம்புகளை"
        },
        {
          "verse": 14,
          "text": "நாள் முழுதும் நான்"
        },
        {
          "verse": 15,
          "text": "அவர் கசப்புணவால்"
        },
        {
          "verse": 16,
          "text": "கற்களால் என் பற்களை"
        },
        {
          "verse": 17,
          "text": "அமைதியை நான் இழக்கச் செய்தீர்!"
        },
        {
          "verse": 18,
          "text": "‘என் வலிமையும் ஆண்டவர்மீது"
        },
        {
          "verse": 19,
          "text": "என் துயரத்தையும் அலைச்சலையும்,"
        },
        {
          "verse": 20,
          "text": "அதை நினைந்து நினைந்து"
        },
        {
          "verse": 21,
          "text": "இதை என் நினைவுக்குக்"
        },
        {
          "verse": 22,
          "text": "‘ஆண்டவரின் பேரன்பு"
        },
        {
          "verse": 23,
          "text": "காலைதோறும் அவை"
        },
        {
          "verse": 24,
          "text": "‘ஆண்டவரே என் பங்கு' என்று"
        },
        {
          "verse": 25,
          "text": "ஆண்டவரில்"
        },
        {
          "verse": 26,
          "text": "ஆண்டவர் அருளும் மீட்புக்காக"
        },
        {
          "verse": 27,
          "text": "இளமையில் நுகம் சுமப்பது"
        },
        {
          "verse": 28,
          "text": "அவரே அதை"
        },
        {
          "verse": 29,
          "text": "அவர்களின் வாய்"
        },
        {
          "verse": 30,
          "text": "தங்களை அறைபவர்களுக்குக்"
        },
        {
          "verse": 31,
          "text": "என் தலைவர் என்றுமே"
        },
        {
          "verse": 32,
          "text": "அவர் வருத்தினாலும்,"
        },
        {
          "verse": 33,
          "text": "மனமார அவர்"
        },
        {
          "verse": 34,
          "text": "நாட்டில் சிறைப்பட்டோர் அனைவரும்"
        },
        {
          "verse": 35,
          "text": "உன்னதரின் திருமுன் மனிதருக்கு"
        },
        {
          "verse": 36,
          "text": "வழக்கில் ஒருவர்"
        },
        {
          "verse": 37,
          "text": "என் தலைவர் கட்டளையிடாமல்,"
        },
        {
          "verse": 38,
          "text": "நன்மையும் தீமையும் புறப்படுவது,"
        },
        {
          "verse": 39,
          "text": "உயிருள்ள மனிதர் முறையிடுவது ஏன்?"
        },
        {
          "verse": 40,
          "text": "நம் வழிகளை ஆய்ந்தறிவோம்!"
        },
        {
          "verse": 41,
          "text": "விண்ணக இறைவனை நோக்கி"
        },
        {
          "verse": 42,
          "text": "நாங்கள் குற்றம் புரிந்து"
        },
        {
          "verse": 43,
          "text": "நீர் சினத்தால் உம்மை மூடிக்கொண்டு"
        },
        {
          "verse": 44,
          "text": "எங்கள் மன்றாட்டு"
        },
        {
          "verse": 45,
          "text": "மக்களினங்கள் இடையே எம்மை"
        },
        {
          "verse": 46,
          "text": "எங்கள் பகைவர் அனைவரும்"
        },
        {
          "verse": 47,
          "text": "திகிலும் படுகுழியும் எம்முன் உள்ளன!"
        },
        {
          "verse": 48,
          "text": "என் மக்களாகிய மகளின்"
        },
        {
          "verse": 49,
          "text": "வற்றாத ஓடையென என் கண்கள்"
        },
        {
          "verse": 50,
          "text": "ஆண்டவர் வானினின்று"
        },
        {
          "verse": 51,
          "text": "என் நகரின் புதல்வியர்"
        },
        {
          "verse": 52,
          "text": "காரணமின்றி என் பகைவர்,"
        },
        {
          "verse": 53,
          "text": "உயிரோடு என்னைக் குழியில் தள்ளி,"
        },
        {
          "verse": 54,
          "text": "வெள்ளம் என் தலைக்குமேல் போயிற்று!"
        },
        {
          "verse": 55,
          "text": "படுகுழியினின்று ஆண்டவரே!"
        },
        {
          "verse": 56,
          "text": "என் குரலை நீர் கேட்டீர்;"
        },
        {
          "verse": 57,
          "text": "உம்மை நோக்கி நான்"
        },
        {
          "verse": 58,
          "text": "என் தலைவரே!"
        },
        {
          "verse": 59,
          "text": "ஆண்டவரே! எனக்கு"
        },
        {
          "verse": 60,
          "text": "அவர்களின் பழிவாங்கும்"
        },
        {
          "verse": 61,
          "text": "ஆண்டவரே!"
        },
        {
          "verse": 62,
          "text": "என் பகைவர் நாள் முழுவதும்"
        },
        {
          "verse": 63,
          "text": "பாரும்! அவர்கள்"
        },
        {
          "verse": 64,
          "text": "ஆண்டவரே!"
        },
        {
          "verse": 65,
          "text": "நீர் அவர்கள் மனதைக்"
        },
        {
          "verse": 66,
          "text": "ஆண்டவரே, சினம் கொண்டு"
        }
      ]
    },
    {
      "chapter": 4,
      "verses": [
        {
          "verse": 1,
          "text": "ஐயோ! பொன் இப்படி மங்கிப் போயிற்றே!"
        },
        {
          "verse": 2,
          "text": "பசும்பொன்னுக்கு இணையான"
        },
        {
          "verse": 3,
          "text": "குள்ளநரிகளும்"
        },
        {
          "verse": 4,
          "text": "பால்குடி மறவாத மழலைகளின் நாவு"
        },
        {
          "verse": 5,
          "text": "சுவையுணவு அருந்தினோர்"
        },
        {
          "verse": 6,
          "text": "ஒருவரும் கை வைக்காமல்"
        },
        {
          "verse": 7,
          "text": "அவள் இளவரசர்"
        },
        {
          "verse": 8,
          "text": "இப்பொழுதோ, அவர்கள் தோற்றம்"
        },
        {
          "verse": 9,
          "text": "பசியினால் மாண்டவர்களினும்"
        },
        {
          "verse": 10,
          "text": "இரங்கும் பெண்டிரின் கைகள்"
        },
        {
          "verse": 11,
          "text": "ஆண்டவர் தம் சீற்றத்தைத்"
        },
        {
          "verse": 12,
          "text": "பகைவரும் எதிரிகளும்"
        },
        {
          "verse": 13,
          "text": "நகரின் நடுவே"
        },
        {
          "verse": 14,
          "text": "அவர்கள் குருடரெனத்"
        },
        {
          "verse": 15,
          "text": "விலகுங்கள்! தீட்டு! விலகுங்கள்!"
        },
        {
          "verse": 16,
          "text": "ஆண்டவரே தம் முன்னிலையினின்று"
        },
        {
          "verse": 17,
          "text": "உதவியை வீணில் எதிர்பார்த்து"
        },
        {
          "verse": 18,
          "text": "எம் நடமாட்டம் கவனிக்கப்பட்டது;"
        },
        {
          "verse": 19,
          "text": "வானத்துப் பருந்துகளிலும் விரைவாய்"
        },
        {
          "verse": 20,
          "text": "ஆண்டவரின் திருப்பொழிவு பெற்று"
        },
        {
          "verse": 21,
          "text": "ஊசு நாட்டில் வாழும் மகளே!"
        },
        {
          "verse": 22,
          "text": "மகளே! சீயோன்!"
        }
      ]
    },
    {
      "chapter": 5,
      "verses": [
        {
          "verse": 1,
          "text": "ஆண்டவரே, எங்களுக்கு நேரிட்டதை"
        },
        {
          "verse": 2,
          "text": "எங்கள் உரிமைச்சொத்து"
        },
        {
          "verse": 3,
          "text": "நாங்கள் தந்தையற்ற"
        },
        {
          "verse": 4,
          "text": "நாங்கள் தண்ணீரை"
        },
        {
          "verse": 5,
          "text": "கழுத்தில் நுகத்தோடு"
        },
        {
          "verse": 6,
          "text": "உணவால் நிறைவு பெற,"
        },
        {
          "verse": 7,
          "text": "பாவம் செய்த எம் தந்தையர்"
        },
        {
          "verse": 8,
          "text": "அடிமைகள் எங்களை"
        },
        {
          "verse": 9,
          "text": "பாலைநில வாளை முன்னிட்டு,"
        },
        {
          "verse": 10,
          "text": "பஞ்சத்தின் கொடுந்தணலால்"
        },
        {
          "verse": 11,
