{
  "bookId": "zep",
  "bookName": "செப்பனியா",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "ஆமோனின் மகன் யோசியா யூதாவின் அரசனாய் இருந்தபொழுது செப்பனியாவுக்கு ஆண்டவரின் வாக்கு அருளப்பட்டது. இவர் எசேக்கியாவின் கொள்ளுப் பேரனும் அமரியாவின் பேரனும் கெதலியாவின் மகனுமான கூசியின் மைந்தர் ஆவார்."
        },
        {
          "verse": 2,
          "text": "\"மண்ணுலகில் எதுவும் இராதவாறு"
        },
        {
          "verse": 3,
          "text": "அனைத்தையும் அழித்துவிடுவேன்,\""
        },
        {
          "verse": 4,
          "text": "யூதாவுக்கும் எருசலேமில் வாழும்"
        },
        {
          "verse": 5,
          "text": "வீட்டின் மேல்தளத்திலிருந்து"
        },
        {
          "verse": 6,
          "text": "ஆண்டவரைவிட்டு விலகிச் செல்வோரையும்"
        },
        {
          "verse": 7,
          "text": "தலைவராகிய ஆண்டவர் திருமுன்"
        },
        {
          "verse": 8,
          "text": "ஆண்டவரது பலியின் நாளில்"
        },
        {
          "verse": 9,
          "text": "வாயிற்படியை மிதிக்காமல்"
        },
        {
          "verse": 10,
          "text": "ஆண்டவர் கூறுகின்றார்:"
        },
        {
          "verse": 11,
          "text": "நகரின் கீழ்ப்பகுதியில் குடியிருப்போரே!"
        },
        {
          "verse": 12,
          "text": "அக்காலத்தில்,"
        },
        {
          "verse": 13,
          "text": "அவர்களுடைய உடைமைகள்"
        },
        {
          "verse": 14,
          "text": "ஆண்டவரின் மாபெரும் நாள்"
        },
        {
          "verse": 15,
          "text": "அந்த நாள் கடும் சினத்தின் நாள்;"
        },
        {
          "verse": 16,
          "text": "அரண்சூழ் நகர்களுக்கும்"
        },
        {
          "verse": 17,
          "text": "மானிடர்மேல் துன்பம் வரச்செய்வேன்;"
        },
        {
          "verse": 18,
          "text": "ஆண்டவரது சினத்தின் நாளில்,"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "பண்புகெட்ட இனமே!"
        },
        {
          "verse": 2,
          "text": "பதரைப்போல் நீங்கள்"
        },
        {
          "verse": 3,
          "text": "நாட்டிலிருக்கும் எளியோரே!"
        },
        {
          "verse": 4,
          "text": "காசா குடியற்றுப்போகும்;"
        },
        {
          "verse": 5,
          "text": "கடற்கரையில் வாழும்"
        },
        {
          "verse": 6,
          "text": "இவ்வாறு அந்தக் கடற்கரை நாடு"
        },
        {
          "verse": 7,
          "text": "அந்தக் கடற்கரை"
        },
        {
          "verse": 8,
          "text": "மோவாபின் பழிப்புரைகளையும்"
        },
        {
          "verse": 9,
          "text": "ஆதலால், படைகளின் ஆண்டவரும்,"
        },
        {
          "verse": 10,
          "text": "அவர்களுடைய இறுமாப்புக்குக்"
        },
        {
          "verse": 11,
          "text": "ஆண்டவர் அவர்களை"
        },
        {
          "verse": 12,
          "text": "எத்தியோப்பியரே!"
        },
        {
          "verse": 13,
          "text": "வடதிசைக்கு எதிராகத்"
        },
        {
          "verse": 14,
          "text": "அங்கே மந்தைகளும்"
        },
        {
          "verse": 15,
          "text": "\"நான் ஒப்புயர்வு அற்றவன்\" என்று"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "கலகம் செய்ததும் தீட்டுப்பட்டதும்"
        },
        {
          "verse": 2,
          "text": "எந்தச் சொல்லுக்கும் அவள்"
        },
        {
          "verse": 3,
          "text": "அந்நகரின் தலைவர்கள்"
        },
        {
          "verse": 4,
          "text": "அதன் இறைவாக்கினர்"
        },
        {
          "verse": 5,
          "text": "அதனுள் இருக்கும் ஆண்டவரோ"
        },
        {
          "verse": 6,
          "text": "வேற்றினத்தாரை நான்"
        },
        {
          "verse": 7,
          "text": "\"உறுதியாக எனக்கு நீ அஞ்சி நடப்பாய்;"
        },
        {
          "verse": 8,
          "text": "ஆதலால் ஆண்டவர்"
        },
        {
          "verse": 9,
          "text": "அக்காலத்தில் நான்"
        },
        {
          "verse": 10,
          "text": "எத்தியோப்பியாவின் ஆறுகளுக்கும்"
        },
        {
          "verse": 11,
          "text": "எனக்கு எதிராக எழுந்து"
        },
        {
          "verse": 12,
          "text": "ஏழை எளியோரை உன் நடுவில்"
        },
        {
          "verse": 13,
          "text": "இஸ்ரயேலில் எஞ்சியோர்"
        },
        {
          "verse": 14,
          "text": "மகளே சீயோன்! மகிழ்ச்சியால் ஆர்ப்பரி;"
        },
        {
          "verse": 15,
          "text": "ஆண்டவர் உன் தண்டனைத் தீர்ப்பைத்"
        },
        {
          "verse": 16,
          "text": "அந்நாளில் எருசலேமை நோக்கி"
        },
        {
          "verse": 17,
          "text": "உன் கடவுளாகிய ஆண்டவர்"
        },
        {
          "verse": 18,
          "text": "அது திருவிழாக் காலம்போல் இருக்கும்."
        },
        {
          "verse": 19,
          "text": "இதோ!, உன்னை ஒடுக்கியவர்களை"
        },
        {
          "verse": 20,
          "text": "அக்காலத்தில் உங்களை"
        }
      ]
    }
  ]
}