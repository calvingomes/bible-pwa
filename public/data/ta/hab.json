{
  "bookId": "hab",
  "bookName": "அபகூக்",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "இறைவாக்கினர் அபக்கூக்கு கண்ட காட்சியில் அருளப்பட்ட இறைவாக்கு:"
        },
        {
          "verse": 2,
          "text": "ஆண்டவரே,"
        },
        {
          "verse": 3,
          "text": "நீர் என்னை ஏன்"
        },
        {
          "verse": 4,
          "text": "ஆதலால் திருச்சட்டம்"
        },
        {
          "verse": 5,
          "text": "நீங்கள் உங்களைச் சூழ்ந்துள்ள"
        },
        {
          "verse": 6,
          "text": "நான் கல்தேயர் இனத்தை"
        },
        {
          "verse": 7,
          "text": "அவர்கள் அச்சமும் திகிலும்"
        },
        {
          "verse": 8,
          "text": "வேங்கையைவிட"
        },
        {
          "verse": 9,
          "text": "அவர்கள் யாவரும்"
        },
        {
          "verse": 10,
          "text": "அரசர்களை அவர்கள்"
        },
        {
          "verse": 11,
          "text": "அவர்கள் காற்றைப்போல் விரைவாகக்"
        },
        {
          "verse": 12,
          "text": "ஆண்டவரே, என் கடவுளே,"
        },
        {
          "verse": 13,
          "text": "தீமையைக் காண நாணும்"
        },
        {
          "verse": 14,
          "text": "நீர் மானிடரைக்"
        },
        {
          "verse": 15,
          "text": "கல்தேய இனத்தார் மற்றெல்லாரையும்"
        },
        {
          "verse": 16,
          "text": "ஆதலால், தங்கள் வலைக்குப்"
        },
        {
          "verse": 17,
          "text": "அப்படியானால், அவர்கள்"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "[நான் காவல் மாடத்தில் நிற்பேன்;"
        },
        {
          "verse": 2,
          "text": "ஆண்டவர் எனக்கு அளித்த"
        },
        {
          "verse": 3,
          "text": "குறித்த காலத்தில்"
        },
        {
          "verse": 4,
          "text": "இதை நம்பாதவரோ உள்ளத்திலே"
        },
        {
          "verse": 5,
          "text": "மேலும் செல்வம் ஏமாற்றிவிடும்;"
        },
        {
          "verse": 6,
          "text": "ஆனால், தோல்வியுற்ற அனைவரும்"
        },
        {
          "verse": 7,
          "text": "உமக்குக் கடன் கொடுத்தவர்கள்"
        },
        {
          "verse": 8,
          "text": "நீ பல நாட்டினரைச் சூறையாடினாய்;"
        },
        {
          "verse": 9,
          "text": "தீமையின் பளுவிலிருந்து தப்ப,"
        },
        {
          "verse": 10,
          "text": "உன் திட்டங்களால்"
        },
        {
          "verse": 11,
          "text": "சுவரிலிருக்கும் கற்களும்"
        },
        {
          "verse": 12,
          "text": "இரத்தப்பழியால் நகரைக் கட்டி எழுப்பி,"
        },
        {
          "verse": 13,
          "text": "மக்களினங்களின் உழைப்பு"
        },
        {
          "verse": 14,
          "text": "தண்ணீரால்"
        },
        {
          "verse": 15,
          "text": "அடுத்திருப்பவர் மீது"
        },
        {
          "verse": 16,
          "text": "நீ மேன்மை அடையாது"
        },
        {
          "verse": 17,
          "text": "லெபனோனுக்கு நீ செய்த கொடுமை"
        },
        {
          "verse": 18,
          "text": "சிற்பி செதுக்கிய சிலையாலும்,"
        },
        {
          "verse": 19,
          "text": "மரக்கட்டையிடம்,"
        },
        {
          "verse": 20,
          "text": "ஆனால் ஆண்டவர்"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "இறைவாக்கினர் அபக்கூக்கு ‘சிகாயோன்' பண்களில் பாடிய மன்றாட்டு:"
        },
        {
          "verse": 2,
          "text": "ஆண்டவரே,"
        },
        {
          "verse": 3,
          "text": "தேமானிலிருந்து"
        },
        {
          "verse": 4,
          "text": "அவரது பேரொளி"
        },
        {
          "verse": 5,
          "text": "அவருக்கு முன்பாகப்"
        },
        {
          "verse": 6,
          "text": "அவர் நின்றால்,"
        },
        {
          "verse": 7,
          "text": "கூசாவின் கூடாரங்களில்"
        },
        {
          "verse": 8,
          "text": "ஆண்டவரே,"
        },
        {
          "verse": 9,
          "text": "நீர் உம் வில்லைக் கையிலெடுத்து"
        },
        {
          "verse": 10,
          "text": "மலைகள் உம்மைக்கண்டு"
        },
        {
          "verse": 11,
          "text": "கதிரவனும் நிலவும்"
        },
        {
          "verse": 12,
          "text": "சினத்தோடு மண்ணுலகில்"
        },
        {
          "verse": 13,
          "text": "உம் மக்களை மீட்கவும்,"
        },
        {
          "verse": 14,
          "text": "அவன் படைத்தலைவனின் தலையை"
        },
        {
          "verse": 15,
          "text": "ஆனால், நீர்"
        },
        {
          "verse": 16,
          "text": "இதை நான் கேட்கும்போது"
        },
        {
          "verse": 17,
          "text": "அத்திமரம் துளிர்த்து"
        },
        {
          "verse": 18,
          "text": "நான் ஆண்டவரில் களிகூர்வேன்;"
        },
        {
          "verse": 19,
          "text": "ஆண்டவராகிய என் தலைவரே"
        }
      ]
    }
  ]
}