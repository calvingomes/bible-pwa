{
  "bookId": "sng",
  "bookName": "உன்னதப் பாட்டு",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "சாலமோனின் தலைசிறந்த பாடல்"
        },
        {
          "verse": 2,
          "text": "தம் வாயின் முத்தங்களால்"
        },
        {
          "verse": 3,
          "text": "உமது பரிமளத்தின் நறுமணம்"
        },
        {
          "verse": 4,
          "text": "உம்மோடு என்னைக்"
        },
        {
          "verse": 5,
          "text": "எருசலேம் மங்கையரே,"
        },
        {
          "verse": 6,
          "text": "கறுப்பாய் இருக்கின்றேன் நான் என"
        },
        {
          "verse": 7,
          "text": "என் நெஞ்சத்தின் அன்புக்குரியவரே!"
        },
        {
          "verse": 8,
          "text": "பெண்களுக்குள் பேரழகியே,"
        },
        {
          "verse": 9,
          "text": "என் அன்பே, பார்வோன்"
        },
        {
          "verse": 10,
          "text": "உன் கன்னங்கள் குழையணிகளாலும்"
        },
        {
          "verse": 11,
          "text": "பொன்வளையல்கள்"
        },
        {
          "verse": 12,
          "text": "என் அரசர் தம் மஞ்சத்தில்"
        },
        {
          "verse": 13,
          "text": "என் காதலர்"
        },
        {
          "verse": 14,
          "text": "என் காதலர் எனக்கு"
        },
        {
          "verse": 15,
          "text": "என்னே உன் அழகு! என் அன்பே,"
        },
        {
          "verse": 16,
          "text": "என்னே உம் அழகு என் காதலரே!"
        },
        {
          "verse": 17,
          "text": "நம் வீட்டின் விட்டங்கள்"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "சாரோன் சமவெளியில் உள்ள காட்டு"
        },
        {
          "verse": 2,
          "text": "முட்புதர் நடுவில் இருக்கும்"
        },
        {
          "verse": 3,
          "text": "காட்டு மரங்களிடை நிற்கும்"
        },
        {
          "verse": 4,
          "text": "திராட்சை இரசம் வைக்கும்"
        },
        {
          "verse": 5,
          "text": "திராட்சை அடைகள் கொடுத்து"
        },
        {
          "verse": 6,
          "text": "இடக்கையால் அவர் என் தலையைத்"
        },
        {
          "verse": 7,
          "text": "எருசலேம் மங்கையரே!"
        },
        {
          "verse": 8,
          "text": "என் காதலர் குரல் கேட்கின்றது;"
        },
        {
          "verse": 9,
          "text": "என் காதலர் கலைமானுக்கு அல்லது"
        },
        {
          "verse": 10,
          "text": "என் காதலர் என்னிடம் கூறுகின்றார்:"
        },
        {
          "verse": 11,
          "text": "இதோ, கார்காலம் கடந்துவிட்டது;"
        },
        {
          "verse": 12,
          "text": "நிலத்தில் மலர்கள் தோன்றுகின்றன;"
        },
        {
          "verse": 13,
          "text": "அத்திப் பழங்கள் கனிந்துவிட்டன;"
        },
        {
          "verse": 14,
          "text": "பாறைப் பிளவுகளில் இருப்பவளே,"
        },
        {
          "verse": 15,
          "text": "பிடியுங்கள் எமக்காக நரிகளை;"
        },
        {
          "verse": 16,
          "text": "என் காதலர் எனக்குரியர்;"
        },
        {
          "verse": 17,
          "text": "பொழுது புலர்வதற்குள்,"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "இரவு நேரம் படுக்கையில் இருந்தேன்;"
        },
        {
          "verse": 2,
          "text": "\"எழுந்திடுவேன்; நகரத்தில்"
        },
        {
          "verse": 3,
          "text": "ஆனால் என்னைக் கண்டனர்"
        },
        {
          "verse": 4,
          "text": "அவர்களைவிட்டுச்"
        },
        {
          "verse": 5,
          "text": "எருசலேம் மங்கையரே,"
        },
        {
          "verse": 6,
          "text": "என்ன அது?"
        },
        {
          "verse": 7,
          "text": "அதுதான் சாலமோனின் பஞ்சணை!"
        },
        {
          "verse": 8,
          "text": "அனைவரும் வாளேந்திய வீரர்!"
        },
        {
          "verse": 9,
          "text": "மன்னர் தமக்கொரு பல்லக்கு செய்தார்;"
        },
        {
          "verse": 10,
          "text": "அதன் தூண்களை"
        },
        {
          "verse": 11,
          "text": "சீயோன் மங்கையரே, பாருங்கள்!"
        }
      ]
    },
    {
      "chapter": 4,
      "verses": [
        {
          "verse": 1,
          "text": "என்னே உன் அழகு! \"என் அன்பே,"
        },
        {
          "verse": 2,
          "text": "உன் பற்களோ மயிர் கத்தரிப்பதற்கெனக்"
        },
        {
          "verse": 3,
          "text": "செம்பட்டு இழைபோன்றன"
        },
        {
          "verse": 4,
          "text": "தாவீதின் கொத்தளம்போல்"
        },
        {
          "verse": 5,
          "text": "உன் முலைகள் இரண்டும்"
        },
        {
          "verse": 6,
          "text": "பொழுது புலர்வதற்குள்"
        },
        {
          "verse": 7,
          "text": "என் அன்பே"
        },
        {
          "verse": 8,
          "text": "லெபனோனிலிருந்து வந்திடு மணமகளே;"
        },
        {
          "verse": 9,
          "text": "என் உள்ளத்தைக்"
        },
        {
          "verse": 10,
          "text": "உன் காதல் எத்துணை நேர்த்தியானது;"
        },
        {
          "verse": 11,
          "text": "மணமகளே, உன் இதழ்கள்"
        },
        {
          "verse": 12,
          "text": "பூட்டியுள்ள தோட்டம் நீ;"
        },
        {
          "verse": 13,
          "text": "மாதுளைச் சோலையாய்த்"
        },
        {
          "verse": 14,
          "text": "நரந்தம், மஞ்சள், வசம்பு, இலவங்கம்"
        },
        {
          "verse": 15,
          "text": "நீ தோட்டங்களின் நீரூற்று;"
        },
        {
          "verse": 16,
          "text": "வாடையே, எழு! தென்றலே, வா!"
        }
      ]
    },
    {
      "chapter": 5,
      "verses": [
        {
          "verse": 1,
          "text": "என் தோட்டத்திற்கு நான்"
        },
        {
          "verse": 2,
          "text": "நான் உறங்கினேன்;"
        },
        {
          "verse": 3,
          "text": "\"என் ஆடையைக் களைந்து விட்டேன்;"
        },
        {
          "verse": 4,
          "text": "என் காதலர் கதவுத் துளை வழியாகக்"
        },
        {
          "verse": 5,
          "text": "எழுந்தேன் நான்,"
        },
        {
          "verse": 6,
          "text": "கதவைத் திறந்தேன் நான்"
        },
        {
          "verse": 7,
          "text": "ஆனால் என்னைக் கண்டனர்"
        },
        {
          "verse": 8,
          "text": "எருசலேம் மங்கையரே,"
        },
        {
          "verse": 9,
          "text": "\"பெண்களுக்குள் பேரழகியே,"
        },
        {
          "verse": 10,
          "text": "\"என் காதலர் ஒளிமிகு சிவந்த மேனியர்;"
        },
        {
          "verse": 11,
          "text": "அவரது தலை பசும்பொன்;"
        },
        {
          "verse": 12,
          "text": "அவர் கண்கள்"
        },
        {
          "verse": 13,
          "text": "அவர் கன்னங்கள் நறுமண"
        },
        {
          "verse": 14,
          "text": "அவருடைய கைகள்"
        },
        {
          "verse": 15,
          "text": "அவருடைய கால்கள்"
        },
        {
          "verse": 16,
          "text": "அவரது வாய் இணையற்ற இனிமை;"
        }
      ]
    },
    {
      "chapter": 6,
      "verses": [
        {
          "verse": 1,
          "text": "\"பெண்களுக்குள் பேரழகியே,"
        },
        {
          "verse": 2,
          "text": "\"என் காதலர் தம் தோட்டத்திற்கும்"
        },
        {
          "verse": 3,
          "text": "நான் என் காதலர்க்குரியள்;"
        },
        {
          "verse": 4,
          "text": "என் அன்பே.நீ திரட்சாவைப்போல்"
        },
        {
          "verse": 5,
          "text": "என்னிடமிருந்து உன் கண்களைத்"
        },
        {
          "verse": 6,
          "text": "உன் பற்களோ, குளித்துக்கரையேறும்"
        },
        {
          "verse": 7,
          "text": "முகத்திரையின் பின்னிருக்கும்"
        },
        {
          "verse": 8,
          "text": "அரசியர் அறுபது பேர்;"
        },
        {
          "verse": 9,
          "text": "என் வெண்புறா,"
        },
        {
          "verse": 10,
          "text": "\"யாரிவள்!"
        },
        {
          "verse": 11,
          "text": "வாதுமைச் சோலைக்குள் சென்றேன்;"
        },
        {
          "verse": 12,
          "text": "என்னவென்றே"
        },
        {
          "verse": 13,
          "text": "திரும்பி வா! திரும்பி வா!"
        }
      ]
    },
    {
      "chapter": 7,
      "verses": [
        {
          "verse": 1,
          "text": "அரசிள மகளே!"
        },
        {
          "verse": 2,
          "text": "உன் கொப்பூழ்"
        },
        {
          "verse": 3,
          "text": "உன் முலைகள் இரண்டும்"
        },
        {
          "verse": 4,
          "text": "உன் கழுத்து தந்தத்தாலான"
        },
        {
          "verse": 5,
          "text": "உன் தலை கர்மேல் மலைபோல்"
        },
        {
          "verse": 6,
          "text": "அன்பே! இன்பத்தின் மகளே!"
        },
        {
          "verse": 7,
          "text": "இந்த உன் வளர்த்தி"
        },
        {
          "verse": 8,
          "text": "ஆம், பேரீச்சையின்மேல்"
        },
        {
          "verse": 9,
          "text": "இதழ்களுக்கும் பற்களுக்கும் மேலே"
        },
        {
          "verse": 10,
          "text": "நான் என் காதலர்க்குரியள்;"
        },
        {
          "verse": 11,
          "text": "என் காதலரே, வாரும்;"
        },
        {
          "verse": 12,
          "text": "வைகறையில் திராட்சைத்"
        },
        {
          "verse": 13,
          "text": "காதற்கனிகளின் மணம் கமழுகின்றது;"
        }
      ]
    },
    {
      "chapter": 8,
      "verses": [
        {
          "verse": 1,
          "text": "நீர் என் உடன்பிறப்பாக"
        },
        {
          "verse": 2,
          "text": "உம்மை என் தாய் வீட்டுக்குக்"
        },
        {
          "verse": 3,
          "text": "இடக்கையால் அவர்"
        },
        {
          "verse": 4,
          "text": "எருசலேம் மங்கையரே,"
        },
        {
          "verse": 5,
          "text": "\"யார் இவள்!"
        },
        {
          "verse": 5,
          "text": "கிச்சிலி மரத்தடியில்"
        },
        {
          "verse": 6,
          "text": "உம் நெஞ்சத்தில் இலச்சினைபோல்"
        },
        {
          "verse": 7,
          "text": "பெருங்கடலும்"
        },
        {
          "verse": 8,
          "text": "நம்முடைய தங்கை சிறியவள்;"
        },
        {
          "verse": 9,
          "text": "அவள் ஒரு மதிலானால்"
        },
        {
          "verse": 10,
          "text": "நான் மதில்தான்;"
        },
        {
          "verse": 11,
          "text": "பாகால்-ஆமோன் என்னுமிடத்தில்"
        },
        {
          "verse": 12,
          "text": "எனக்குரிய திராட்சைத் தோட்டம்"
        },
        {
          "verse": 13,
          "text": "\"தோட்டங்களில் வாழ்பவளே!"
        },
        {
          "verse": 14,
          "text": "\"என் காதலரே!"
        }
      ]
    }
  ]
}