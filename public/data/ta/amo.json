{
  "bookId": "amo",
  "bookName": "ஆமோஸ்",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "தெக்கோவாவில் கால்நடைச் செல்வம் மிகுதியாக உடையவர்களுள் ஒருவர் ஆமோஸ். யூதாவை உசியாவும் இஸ்ரயேலை யோவாசின் மகன் எரொபவாமும் ஆண்டுவந்த காலத்தில், நிலநடுக்கம் ஏற்படுவதற்கு இரண்டாண்டுகளுக்கு முன், இஸ்ரயேலைக் குறித்து ஆமோஸ் காட்சி கண்டு கூறியவை பின்வருமாறு:"
        },
        {
          "verse": 2,
          "text": "\"சீயோனிலிருந்து ஆண்டவர்"
        },
        {
          "verse": 3,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 4,
          "text": "ஆதலால் அசாயேல் வீட்டின்மேல்"
        },
        {
          "verse": 5,
          "text": "தமஸ்குவின் தாழ்ப்பாளை உடைப்பேன்."
        },
        {
          "verse": 6,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 7,
          "text": "ஆதலால் காசாவின்"
        },
        {
          "verse": 8,
          "text": "அஸ்தோதில் குடியிருப்பவர்களையும்"
        },
        {
          "verse": 9,
          "text": "ஆண்டவர் கூறுவுது இதுவே:"
        },
        {
          "verse": 10,
          "text": "ஆதலால் தீரின் கோட்டை"
        },
        {
          "verse": 11,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 12,
          "text": "ஆதலால் தேமான்மேல்"
        },
        {
          "verse": 13,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 14,
          "text": "ஆதலால், இராபாவின் கோட்டை"
        },
        {
          "verse": 15,
          "text": "அவர்களுடைய அரசன்"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "ஆண்டவர் கூறுவது இதுவே: \"மோவாபு"
        },
        {
          "verse": 2,
          "text": "ஆதலால், மோவாபின்மேல்"
        },
        {
          "verse": 3,
          "text": "அந்நாட்டின் ஆட்சியாளனை"
        },
        {
          "verse": 4,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 5,
          "text": "ஆதலால் யூதாவின்மேல்"
        },
        {
          "verse": 6,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 7,
          "text": "ஏழைகளின் தலைகளை மண்ணில்"
        },
        {
          "verse": 8,
          "text": "கடன்காரரிடமிருந்து"
        },
        {
          "verse": 9,
          "text": "நானோ கேதுரு மரத்தின் உயரமும்"
        },
        {
          "verse": 10,
          "text": "மேலும், எகிப்து நாட்டிலிருந்து"
        },
        {
          "verse": 11,
          "text": "உங்கள் புதல்வர்களுள் சிலரை"
        },
        {
          "verse": 12,
          "text": "ஆனால், நீங்கள் நாசீர்களை"
        },
        {
          "verse": 13,
          "text": "வைக்கோல் பொதி நிறைந்த வண்டி"
        },
        {
          "verse": 14,
          "text": "விரைந்தோடுகிறவனும் தப்ப முடியாது;"
        },
        {
          "verse": 15,
          "text": "வில்லேந்தும் வீரன்"
        },
        {
          "verse": 16,
          "text": "அந்நாளில் வலிமை மிக்கவர்களுள்"
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "இஸ்ரயேல் மக்களே! கேளுங்கள்; உங்களுக்கு எதிராக — ஆம், எகிப்து நாட்டினின்று நான் அழைத்து வந்த முழுக் குடும்பமாகிய உங்களுக்கு எதிராக — ஆண்டவர் உரைக்கும் இந்த வாக்கைக் கேளுங்கள்;"
        },
        {
          "verse": 2,
          "text": "\"உலகத்திலுள்ள எல்லா"
        },
        {
          "verse": 3,
          "text": "தங்களுக்குள் உடன்பாடு இல்லாமல்"
        },
        {
          "verse": 4,
          "text": "இரை அகப்படாமல் இருக்கும்போது"
        },
        {
          "verse": 5,
          "text": "வேடன் தரையில்"
        },
        {
          "verse": 6,
          "text": "நகரில் எக்காளம் ஊதப்படுமானால்,"
        },
        {
          "verse": 7,
          "text": "தம் ஊழியர்களாகிய"
        },
        {
          "verse": 8,
          "text": "சிங்கம் கர்ச்சனை செய்கின்றது;"
        },
        {
          "verse": 9,
          "text": "\"அசீரியாவின் கோட்டைகள் மேலும்"
        },
        {
          "verse": 10,
          "text": "நலமானதைச் செய்ய"
        },
        {
          "verse": 11,
          "text": "ஆகையால், தலைவராகிய ஆண்டவர்"
        },
        {
          "verse": 12,
          "text": "ஆண்டவர் கூறுவது இதுவே:"
        },
        {
          "verse": 13,
          "text": "\"கேளுங்கள்;"
        },
        {
          "verse": 14,
          "text": "\"இஸ்ரயேலை"
        },
        {
          "verse": 15,
          "text": "குளிர்கால வேனிற்கால மாளிகைகளை"
        }
      ]
    },
    {
      "chapter": 4,
      "verses": [
        {
          "verse": 1,
          "text": "\"சமாரியா மலைமேல் வாழும் பாசான்"
        },
        {
          "verse": 2,
          "text": "இறைவனாகிய ஆண்டவர்"
        },
        {
          "verse": 3,
          "text": "நீங்கள் ஒருவர் பின் ஒருவராய்"
        },
        {
          "verse": 4,
          "text": "\"வாருங்கள், பெத்தேலுக்கு வந்து"
        },
        {
          "verse": 5,
          "text": "புளித்த மாவின் அப்பத்தைக்"
        },
        {
          "verse": 6,
          "text": "\"உங்கள் நகர்களில் எல்லாம்"
        },
        {
          "verse": 7,
          "text": "\"நீங்கள் அறுவடை செய்ய"
        },
        {
          "verse": 8,
          "text": "ஆகையால், இரண்டு மூன்று"
        },
        {
          "verse": 9,
          "text": "‘வெப்பக் காற்றாலும்"
        },
        {
          "verse": 10,
          "text": "\"எகிப்தின்மீது அனுப்பிய"
        },
        {
          "verse": 11,
          "text": "\"சோதோம், கொமோராவின் மக்களைக்"
        },
        {
          "verse": 12,
          "text": "\"ஆகையால், இஸ்ரயேலே!"
        },
        {
          "verse": 13,
          "text": "ஏனெனில், மலைகளை உருவாக்கியர் அவரே;"
        }
      ]
    },
    {
      "chapter": 5,
      "verses": [
        {
          "verse": 1,
          "text": "இஸ்ரயேல் வீட்டாரே, உங்களைப் பற்றி நான் புலம்பிக் கூறும் இந்த வாக்கைக் கேளுங்கள்;"
        },
        {
          "verse": 2,
          "text": "\"இஸ்ரயேல் என்னும் கன்னிப் பெண்"
        },
        {
          "verse": 3,
          "text": "ஏனெனில், தலைவராகிய ஆண்டவர்"
        },
        {
          "verse": 4,
          "text": "இஸ்ரயேல் வீட்டாருக்கு"
        },
        {
          "verse": 5,
          "text": "ஆனால் பெத்தேலைத் தேடாதீர்கள்,"
        },
        {
          "verse": 6,
          "text": "ஆண்டவரைத் தேடுங்கள்;"
        },
        {
          "verse": 7,
          "text": "அவர்கள் நீதியை"
        },
        {
          "verse": 8,
          "text": "ஆனால், அவரே"
        },
        {
          "verse": 9,
          "text": "வலிமை மிக்க தளங்கள்மேல்"
        },
        {
          "verse": 10,
          "text": "அவர்கள் நகர் வாயிலில் நின்றுகொண்டு"
        },
        {
          "verse": 11,
          "text": "நீங்கள் ஏழைகளை நசுக்கி,"
        },
        {
          "verse": 12,
          "text": "உங்கள் குற்றங்கள்"
        },
        {
          "verse": 13,
          "text": "அது கெட்ட காலம் என்பதால்,"
        },
        {
          "verse": 14,
          "text": "நன்மையை நாடுங்கள்,"
        },
        {
          "verse": 15,
          "text": "தீமையை வெறுத்து"
        },
        {
          "verse": 16,
          "text": "ஆகையால், படைகளின் கடவுளும்"
        },
        {
          "verse": 17,
          "text": "திராட்சைத் தோட்டம் எங்கணும்"
        },
        {
          "verse": 18,
          "text": "ஆண்டவரின் நாளைப்"
        },
        {
          "verse": 19,
          "text": "அந்த நாள், சிங்கத்திடமிருந்து"
        },
        {
          "verse": 20,
          "text": "ஆண்டவரின் நாள்"
        },
        {
          "verse": 21,
          "text": "\"உங்கள் திருவிழாக்களை"
        },
        {
          "verse": 22,
          "text": "எரிபலிகளையும்"
        },
        {
          "verse": 23,
          "text": "என் முன்னிலையில்"
        },
        {
          "verse": 24,
          "text": "மாறாக, நீதி"
        },
        {
          "verse": 25,
          "text": "\"இஸ்ரயேல் வீட்டாரே, பாலை நிலத்தில் இருந்த அந்த நாற்பது ஆண்டுகளில் பலிகளும் காணிக்கைகளும் எனக்குக் கொடுத்தீர்களோ?"
        },
        {
          "verse": 26,
          "text": "நீங்கள் சிக்கூத்தை மன்னனாகவும் கிய்யோனை விண்மீன் தெய்வமாகவும் ஏற்றுக் கொண்டீர்கள்; அவற்றின் வடிவில் உங்களுக்கெனச் சிலைகளும் செய்து கொண்டீர்கள்; அந்தச் சிலைகளை நீங்கள் தூக்கிக்கொண்டு போகும் நாள் வரும்."
        },
        {
          "verse": 27,
          "text": "உங்களை நாள் தமஸ்குவுக்கும் அப்பால் நாடுகடத்தப்போகிறேன்\", என்கிறார் ஆண்டவர்; அவரது பெயர் \"படைகளின் கடவுள்.\""
        }
      ]
    },
    {
      "chapter": 6,
      "verses": [
        {
          "verse": 1,
          "text": "\"சீயோன் குன்றின்மீது இன்பத்தில்"
        },
        {
          "verse": 2,
          "text": "கல்னேக்குப் போய்ப் பாருங்கள்;"
        },
        {
          "verse": 3,
          "text": "தீய நாளை"
        },
        {
          "verse": 4,
          "text": "தந்தத்தாலான கட்டிலில்"
        },
        {
          "verse": 5,
          "text": "அவர்கள் வீணையொலி எழுப்பி"
        },
        {
          "verse": 6,
          "text": "கோப்பைகளில்"
        },
        {
          "verse": 7,
          "text": "ஆகையால் அவர்கள்தான்"
        },
        {
          "verse": 8,
          "text": "தலைவராகிய ஆண்டவர்"
        },
        {
          "verse": 9,
          "text": "ஒரு வீட்டில் பத்துப்பேரே இருந்தாலும் அவர்களும் மாண்டு போவார்கள்."
        },
        {
          "verse": 10,
          "text": "வீட்டிலிருந்து எலும்புகளை எடுத்துச் செல்ல மிகச் சிலரே தப்பிப் பிழைப்பார்கள்; ஒருவன், வீட்டில் மூலையிலிருக்கும் இன்னொருவனிடம், \"உன்னுடன் வேறு யாரேனும் உளரோ?\" என்று கேட்க, அவன், \"இல்லை\" என்று பதில் சொல்லி \"பேசாதே, ஆண்டவரின் பெயரைச் சொல்லக் கூடாது\" என்பான்."
        },
        {
          "verse": 11,
          "text": "ஆண்டவர்தாமே ஆணையிடுகின்றார்;"
        },
        {
          "verse": 12,
          "text": "பாறைகள்மேல் குதிரைகள் ஓடுமோ?"
        },
        {
          "verse": 13,
          "text": "லோதபார் ஊரைப் பிடித்தது குறித்துப்"
        },
        {
          "verse": 14,
          "text": "‘இஸ்ரயேல் வீட்டாரே!"
        }
      ]
    },
    {
      "chapter": 7,
      "verses": [
        {
          "verse": 1,
          "text": "தலைவராகிய ஆண்டவர் எனக்குக் காட்டிய காட்சி இதுவே: \"அரசனுக்கென முதல் புல்லறுப்புச் செய்தானபின், இரண்டாம் பருவத்தில் புற்கள் துளிர்க்கத் தொடங்கும் வேளையில், அவர் வெட்டுக்கிளிக் கூட்டங்களை உருவாக்கிக் கொண்டிருந்தார்."
        },
        {
          "verse": 2,
          "text": "நாட்டிலிருந்த புல்லையெல்லாம் அவை தின்று தீர்த்துக் கொண்டிருந்த வேளையில் நான்"
        },
        {
          "verse": 3,
          "text": "ஆண்டவரும் இதைக் குறித்து"
        },
        {
          "verse": 4,
          "text": "தலைவராகிய ஆண்டவர்"
        },
        {
          "verse": 5,
          "text": "நான்,‘தலைவராகிய ஆண்டவரே,"
        },
        {
          "verse": 6,
          "text": "ஆண்டவரும் இதைக் குறித்து"
        },
        {
          "verse": 7,
          "text": "ஆண்டவர் எனக்குக் காட்டிய"
        },
        {
          "verse": 8,
          "text": "‘ஆமோஸ்!"
        },
        {
          "verse": 9,
          "text": "ஈசாக்கின் உயர்ந்த இடங்கள்"
        },
        {
          "verse": 10,
          "text": "பிறகு, பெத்தேலின் குருவாகிய அமட்சியா என்பவன் இஸ்ரயேலின் அரசன் எரொபவாமுக்கு இவ்வாறு சொல்லியனுப்பினான்: \"இஸ்ரயேல் வீட்டாரிடையே ஆமோஸ் உமக்கு எதிராகச் சதி செய்கிறான்."
        },
        {
          "verse": 11,
          "text": "அவன் சொல்வதை எல்லாம் இந்த நாட்டால் தாங்கமுடியவில்லை. ஏனெனில், ‘எரொபவாம் வாளால் மடிவான்; அவனது நாட்டைவிட்டு இஸ்ரயேல் அடிமையாய்க் கொண்டு போகப்படும்' என்று ஆமோஸ் சொல்லுகிறான்.\""
        },
        {
          "verse": 12,
          "text": "பின்பு அமட்சியா ஆமோசைப் பார்த்து, \"காட்சி காண்பவனே, இங்கிருந்து போய்விடு; யூதாவின் நாட்டுக்கு ஓடிவிடு; அங்கே போய் இறைவாக்கு உரைத்து, உன் பிழைப்பைத் தேடிக்கொள்."
        },
        {
          "verse": 13,
          "text": "பெத்தேலில் இனி ஒருபோதும் இறைவாக்கு உரைக்காதே; ஏனெனில், இது அரசின் புனித இடம், அரசுக்குரிய இல்லம்\" என்று சொன்னான்."
        },
        {
          "verse": 14,
          "text": "ஆமோஸ் அதற்கு மறுமொழியாக அமட்சியாவைப் பார்த்துக் கூறினார்: \"நான் இறைவாக்கினன் இல்லை; இறைவாக்கினர் குழுவில் உறுப்பினனும் இல்லை; நான் ஆடு மாடு மேய்ப்பவன், காட்டு அத்திமரத் தோட்டக்காரன்."
        },
        {
          "verse": 15,
          "text": "ஆடுகள் ஓட்டிக் கொண்டபோன என்னை ஆண்டவர் தேர்ந்தெடுத்து, ‘என் மக்களாகிய இஸ்ரயேலிடம் சென்று, இறைவாக்கு உரைத்திடு' என்று அனுப்பினார்."
        },
        {
          "verse": 16,
          "text": "எனவே, இப்பொழுது"
        },
        {
          "verse": 17,
          "text": "ஆண்டவர் இவ்வாறு கூறுகிறார்:"
        }
      ]
    },
    {
      "chapter": 8,
      "verses": [
        {
          "verse": 1,
          "text": "தலைவராகிய ஆண்டவர் எனக்குக் காட்டிய காட்சி இதுவே: \"கனிந்த பழங்களுள்ள கூடை ஒன்று கண்டேன்."
        },
