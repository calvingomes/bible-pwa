{
  "bookId": "oba",
  "bookName": "ஒபதியா",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "ஓபதியா கண்ட காட்சி: தலைவராகிய"
        },
        {
          "verse": 2,
          "text": "நான் உன்னை மக்களினத்தாரிடையே"
        },
        {
          "verse": 3,
          "text": "பாறை இடுக்குகளில் வாழ்பவனே! உயரத்திலே குடியிருப்பை"
        },
        {
          "verse": 4,
          "text": "நீ கழுகைப் போல்"
        },
        {
          "verse": 5,
          "text": "உன்னிடம் திருடர்கள்"
        },
        {
          "verse": 6,
          "text": "ஏசா எவ்வளவாய்க்"
        },
        {
          "verse": 7,
          "text": "உன்னோடு உடன்படிக்கை"
        },
        {
          "verse": 8,
          "text": "அந்நாளில் நான்"
        },
        {
          "verse": 9,
          "text": "தேமான்! வலிமைமிக்க உன் வீரர்கள்"
        },
        {
          "verse": 10,
          "text": "உன் சகோதரன் யாக்கோபுக்கு எதிராக நீ செய்த கொடுமையை முன்னிட்டு,"
        },
        {
          "verse": 11,
          "text": "அயல் நாட்டார் யாக்கோபின் செல்வத்தைக்"
        },
        {
          "verse": 12,
          "text": "நீ உன் சகோதரனுடைய"
        },
        {
          "verse": 13,
          "text": "என் மக்கள் துன்புற்ற நாளில்,"
        },
        {
          "verse": 14,
          "text": "அவர்களுள் தப்பி ஓடியவர்களை"
        },
        {
          "verse": 15,
          "text": "ஏனெனில், ஆண்டவரின் நாள்"
        },
        {
          "verse": 16,
          "text": "என் திரு மலையில்,"
        },
        {
          "verse": 17,
          "text": "ஆனால், தப்பிப் பிழைத்தோர்"
        },
        {
          "verse": 18,
          "text": "யாக்கோபின் குடும்பத்தார்"
        },
        {
          "verse": 19,
          "text": "நெகேபில் இருப்பவர்கள்"
        },
        {
          "verse": 20,
          "text": "இஸ்ரயேலிலிருந்து"
        },
        {
          "verse": 21,
          "text": "விடுதலை பெற்றோர்"
        }
      ]
    }
  ]
}