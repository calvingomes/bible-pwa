{
  "bookId": "joe",
  "bookName": "யோவேல்",
  "language": "ta",
  "chapters": [
    {
      "chapter": 1,
      "verses": [
        {
          "verse": 1,
          "text": "பெத்துவேலின் மகனான யோவேலுக்கு ஆண்டவர் அருளிய வாக்கு இதுவே:"
        },
        {
          "verse": 2,
          "text": "முதியோரே, இதைக் கேளுங்கள்;"
        },
        {
          "verse": 3,
          "text": "இதைக் குறித்து உங்கள்"
        },
        {
          "verse": 4,
          "text": "வெட்டுப் புழு தின்று எஞ்சியதை"
        },
        {
          "verse": 5,
          "text": "குடிவெறியர்களே,"
        },
        {
          "verse": 6,
          "text": "ஆற்றல்மிக்க,"
        },
        {
          "verse": 7,
          "text": "என்னுடைய திராட்சைக் கொடிகளை"
        },
        {
          "verse": 8,
          "text": "கணவனாக வரவிருந்தவனை"
        },
        {
          "verse": 9,
          "text": "ஆண்டவரது இல்லத்தில்"
        },
        {
          "verse": 10,
          "text": "வயல்வெளிகள் பாழாயின;"
        },
        {
          "verse": 11,
          "text": "உழவுத் தொழில் செய்வோரே,"
        },
        {
          "verse": 12,
          "text": "திராட்சைக் கொடி வாடிப் போகின்றது;"
        },
        {
          "verse": 13,
          "text": "குருக்களே,"
        },
        {
          "verse": 14,
          "text": "உண்ணா நோன்புக்கென"
        },
        {
          "verse": 15,
          "text": "மிகக் கொடிய நாள் அந்த நாள்!"
        },
        {
          "verse": 16,
          "text": "உணவுப் பொருளெல்லாம்"
        },
        {
          "verse": 17,
          "text": "விதைகள் மண்கட்டிகளின் கீழ்"
        },
        {
          "verse": 18,
          "text": "காட்டு விலங்கினங்கள்"
        },
        {
          "verse": 19,
          "text": "ஆண்டவரே, நான்"
        },
        {
          "verse": 20,
          "text": "நீரோடைகள் வற்றிப்போனதால்"
        }
      ]
    },
    {
      "chapter": 2,
      "verses": [
        {
          "verse": 1,
          "text": "சீயோனிலே எக்காளம் ஊதி எச்சரியுங்கள்;"
        },
        {
          "verse": 2,
          "text": "அதுவோ இருளும் காரிருளும்"
        },
        {
          "verse": 3,
          "text": "அவை வரும்பொழுது"
        },
        {
          "verse": 4,
          "text": "பார்வைக்கு அவை"
        },
        {
          "verse": 5,
          "text": "அவை தேர்ப்படைகளின்"
        },
        {
          "verse": 6,
          "text": "அவற்றின் முன்"
        },
        {
          "verse": 7,
          "text": "அவை போர் வீரர்களைப்போல்"
        },
        {
          "verse": 8,
          "text": "ஒன்றை ஒன்று நெருக்குவதில்லை;"
        },
        {
          "verse": 9,
          "text": "நகருக்குள் பாய்ந்து செல்கின்றன;"
        },
        {
          "verse": 10,
          "text": "அவற்றுக்கு முன்பாக"
        },
        {
          "verse": 11,
          "text": "ஆண்டவர் தம் படைகள்முன்"
        },
        {
          "verse": 12,
          "text": "\"இப்பொழுதாவது"
        },
        {
          "verse": 13,
          "text": "\"நீங்கள் உங்கள் உடைகளைக்"
        },
        {
          "verse": 14,
          "text": "ஒருவேளை அவர் தம்"
        },
        {
          "verse": 15,
          "text": "சீயோனில் எக்காளம் ஊதி"
        },
        {
          "verse": 16,
          "text": "மக்களைத் திரண்டு வரச்செய்யுங்கள்;"
        },
        {
          "verse": 17,
          "text": "ஆண்டவரின் ஊழியர்களாகிய குருக்கள்"
        },
        {
          "verse": 18,
          "text": "அப்பொழுது ஆண்டவர்"
        },
        {
          "verse": 19,
          "text": "ஆண்டவர் தம் மக்களுக்கு"
        },
        {
          "verse": 20,
          "text": "வடக்கிலிருந்து வந்த படையை"
        },
        {
          "verse": 21,
          "text": "நிலமே நீ அஞ்சாதே;"
        },
        {
          "verse": 22,
          "text": "காட்டு விலங்குகளே,"
        },
        {
          "verse": 23,
          "text": "சீயோனின் பிள்ளைகளே,"
        },
        {
          "verse": 24,
          "text": "போரடிக்கும் களங்களில்"
        },
        {
          "verse": 25,
          "text": "நான் உங்களுக்கு எதிராக அனுப்பிய"
        },
        {
          "verse": 26,
          "text": "நீங்கள் வேண்டியமட்டும் உண்டு"
        },
        {
          "verse": 27,
          "text": "இஸ்ரயேல் நடுவில்"
        },
        {
          "verse": 28,
          "text": "அதற்குப்பின்பு,"
        },
        {
          "verse": 29,
          "text": "அந்நாள்களில், உங்கள் பணியாளர்,"
        },
        {
          "verse": 30,
          "text": "இன்னும் விண்ணிலும் மண்ணிலும் வியத்தகு செயல்களைச் செய்து காட்டுவேன்; எங்குமே, இரத்த ஆறாகவும் நெருப்பு மண்டலமாகவும், புகைப்படலமாகவும் இருக்கும்."
        },
        {
          "verse": 31,
          "text": "அச்சம் தரும் பெருநாளாகிய ஆண்டவரின் நாள் வருமுன்னே, கதிரவன் இருண்டு போகும்; நிலவோ இரத்தமாக மாறும்."
        },
        {
          "verse": 32,
          "text": "அப்பொழுது ஆண்டவரின் திருப்பெயரைச்சொல்லி வேண்டுவோர் யாவரும் தப்பிப்பிழைப்பர்; ஏனெனில், ஆண்டவர் கூறிய வண்ணமே, சீயோன் மலையிலும் எருசலேமிலும் எஞ்சியிருப்போர் வாழ்வு அடைவர்; ஆண்டவரால் அழைக்கப்பட்டவர்களே தப்பிப் பிழைப்பார்கள்."
        }
      ]
    },
    {
      "chapter": 3,
      "verses": [
        {
          "verse": 1,
          "text": "\"அந்நாள்களில் நான் யூதா, எருசலேம் ஆகியவற்றின் துன்ப நிலைமையை மாற்றி முன்பு இருந்த நிலைமைக்கே கொண்டுவருவேன்;"
        },
        {
          "verse": 2,
          "text": "அப்பொழுது நான் வேற்றினத்தார் அனைவரையும் ஒன்றுசேர்த்து யோசபாத்துப் பள்ளத்தாக்கிற்கு இறங்கிவரச் செய்வேன்; அங்கே நான், என் மக்களும் உரிமைச் சொத்துமாகிய இஸ்ரயேலை முன்னிட்டு அவர்களுக்கு எதிராகத் தண்டனைத் தீர்ப்பு வழங்குவேன்; ஏனெனில், அவர்கள் என் மக்களை வேற்று நாடுகளில் சிதறடித்தார்கள்; எனது நாட்டைத் தங்களுக்குள் பங்கிட்டுக்கொண்டார்கள்;"
        },
        {
          "verse": 3,
          "text": "என் மக்கள் மேல் சீட்டுப்போட்டார்கள்; ஆண் பிள்ளையை விலைமகளுக்குக் கூலியாய்க் கொடுத்தார்கள்; பெண் குழந்தையை விலையாய்க் கொடுத்து, திராட்சை இரசம் வாங்கிக் குடித்தார்கள்."
        },
        {
          "verse": 4,
          "text": "தீர், சீதோன் நகரங்களே, பெலிஸ்தியா நாட்டின் அனைத்துப் பகுதிகளே, எனக்கும் உங்களுக்கும் என்ன வழக்கு? என்னை முற்றிலுமாகப் பழிவாங்குவது உங்கள் எண்ணமோ? அவ்வாறு நீங்கள் பழிவாங்கினால் நான் காலந்தாழ்த்தாமல் நீங்கள் செய்ததையே உங்கள் தலைமேல் வெகு விரைவில் விழச் செய்வேன்."
        },
        {
          "verse": 5,
          "text": "நீங்கள் என் பொன்னையும் வெள்ளியையும் எடுத்துக் கொண்டீர்கள்; விலையுயர்ந்த பொருள்களை உங்கள் அரண்மனைகளுக்கு அள்ளிக்கொண்டு போனீர்கள்."
        },
        {
          "verse": 6,
          "text": "யூதாவின் மைந்தரையும் எருசலேமின் மக்களையும் கிரேக்கரிடம் விற்றுவிட்டீர்கள்; இவ்வாறு அவர்கள் தங்கள் நாட்டைவிட்டு வெகு தொலைவிற்குப் போகச் செய்தீர்கள்."
        },
        {
          "verse": 7,
          "text": "நீங்கள் விற்றுவிட்ட இடத்திலிருந்து அவர்களை இப்பொழுதே கிளர்ந்தெழச் செய்வேன்; நீங்கள் செய்த கொடுமையை உங்கள் தலை மேலேயே விழச் செய்வேன்."
        },
        {
          "verse": 8,
          "text": "உங்கள் புதல்வரையும் புதல்வியரையும் யூதா மக்களிடமே விற்றுவிடுவேன்; யூதா மக்களோ அவர்களைத் தொலைநாட்டவரான செபாயரிடம் விற்றுவிடுவார்கள்; இதைக் கூறுவது ஆண்டவரே."
        },
        {
          "verse": 9,
          "text": "வேற்றினத்தாரிடையே"
        },
        {
          "verse": 10,
          "text": "உங்கள் கலப்பைக் கொழுவைப்"
        },
        {
          "verse": 11,
          "text": "சுற்றுப் புறங்களிலுள்ள"
        },
        {
          "verse": 12,
          "text": "வேற்றினத்தார் அனைவரும்"
        },
        {
          "verse": 13,
          "text": "அரிவாளை எடுத்து அறுங்கள்,"
        },
        {
          "verse": 14,
          "text": "திரள் திரளாய் மக்கட் கூட்டம்"
        },
        {
          "verse": 15,
          "text": "கதிரவனும் நிலவும்"
        },
        {
          "verse": 16,
          "text": "சீயோனிலிருந்து ஆண்டவர்"
        },
        {
          "verse": 17,
          "text": "நானே உங்கள் கடவுளாகிய"
        },
        {
          "verse": 18,
          "text": "\"அந்நாளில் மலைகள்"
        },
        {
          "verse": 19,
          "text": "எகிப்து பாழ்நிலமாகும்;"
        },
        {
          "verse": 20,
          "text": "யூதாவோ என்றென்றும்"
        },
        {
          "verse": 21,
          "text": "சிந்தப்பட்ட இரத்தத்திற்கு"
        }
      ]
    }
  ]
}